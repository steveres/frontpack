{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Authority": "",
    "Audiences": [],
    "RequiredScope": "Slideshow.Access"
  },
  "Tables": {
    "Provider": "Local",
    "LocalPath": "App_Data/data.json"
  },
  "Storage": {
    "Provider": "FileSystem",
    "RootPath": "App_Data/media",
    "ContainerName": "media"
  },
  "Graph": {
    "TenantId": "",
    "ClientId": "",
    "UseManagedIdentityFederation": true
  },
  "Limits": {
    "MaxImageBytes": 52428800,
    "MaxVideoBytes": 1073741824,
    "MaxMusicBytes": 52428800,
    "QuotaBytesPerUser": 10737418240,
    "MaxFilesPerAlbum": 5000,
    "MaxAlbumsPerUser": 500,
    "RequestsPerMinute": 600
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
