{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Authority": "",
    "Audiences": [],
    "RequiredScope": "FrontPack.Access"
  },
  "Users": {
    "Provider": "Local",
    "LocalPath": "../App_Data/users.json"
  },
  "Graph": {
    "TenantId": "",
    "ClientId": "",
    "UseManagedIdentityFederation": true
  },
  "Limits": {
    "QuotaBytesPerUser": 10737418240,
    "RequestsPerMinute": 600
  },
  "Services": [],
  "Cors": {
    "AllowedOrigins": []
  }
}
