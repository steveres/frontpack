<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- FrontPack's own API: the frontpack-api container app. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Container image: dotnet publish /t:PublishContainer (no Docker needed); runs as non-root on port 8080 -->
    <ContainerRepository>frontpack-api</ContainerRepository>
    <ContainerFamily>noble-chiseled-extra</ContainerFamily>
    <!-- Precompiled code: the API starts faster after scaling up from zero (publish only) -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Where `dotnet user-jwts` keeps the development signing key: the same for every host, so a token works on each -->
    <UserSecretsId>70d54e14-b376-478c-bd97-cac8e675e9dd</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../shared/api/FrontPack.ServiceDefaults/FrontPack.ServiceDefaults.csproj" />
    <ProjectReference Include="../../services/frontpack/api/FrontPack.Api/FrontPack.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="FrontPack.ServiceDefaults" />
  </ItemGroup>

</Project>
